# Endpoint MCP Streamable HTTP do servidor ai-memory. O backend deriva daqui
# a origem da API de leitura (/api/v1); o servidor precisa estar com --enable-web.
AI_MEMORY_MCP_URL=https://memory.example.com/mcp

# Token com leitura habilitada (aim_... serve para leitura; mantenha apenas aqui).
AI_MEMORY_AUTH_TOKEN=

# Bearer root separado, usado somente pelo backend para renomear/excluir escopos.
# Não use uma chave aim_... aqui: ela não tem acesso às rotas /admin.
AI_MEMORY_ADMIN_TOKEN=

# Seleção inicial opcional. O painel permite alternar entre todos os escopos
# disponíveis e guarda a última seleção neste navegador.
AI_MEMORY_WORKSPACE=
AI_MEMORY_PROJECT=

# Porta da API local usada pelo painel.
MANAGER_API_PORT=4174

# Banco SQLite local para preferências, auditoria e dados de apoio do painel.
# O padrão é ./data/ai-memory-manager.sqlite; use caminho absoluto no servidor.
MANAGER_DB_PATH=./data/ai-memory-manager.sqlite
