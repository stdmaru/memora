# Chave mestra para criptografar os tokens do node ai-memory no SQLite.
# Gere uma chave aleatoria com: openssl rand -hex 32
MEMORA_CONFIG_ENCRYPTION_KEY=

# Porta da API local usada pelo painel.
MANAGER_API_PORT=4174

# Banco SQLite local para preferencias, auditoria e dados de apoio do painel.
# O padrao e ./data/ai-memory-manager.sqlite; use caminho absoluto no servidor.
MANAGER_DB_PATH=./data/ai-memory-manager.sqlite

# Defina true quando a conexao HTTPS terminar em um proxy reverso confiavel.
MANAGER_COOKIE_SECURE=false
